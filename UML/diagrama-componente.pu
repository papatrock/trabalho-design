@startuml diagrama-componentes

node "Cliente" {
    [Interface Web (SPA/HTML)] as UI
}

node "Servidor" {

    component "Controller Layer" {
        [ReservaController]
        [EspacoController]
        [PagamentoController]
    }

    component "Service Layer (Regras de Negócio)" {
        [Gestão de Reservas] as ServiceReserva
        [Gestão Financeira] as ServicePagamento
        [Gestão de Filiais] as ServiceFilial
    }

    component "Persistence Layer" {
        [ReservaRepository]
        [EspacoRepository]
    }
}

database "Banco de Dados Centralizado" {
    [PostgreSQL / MySQL] as DB
}

UI --> [ReservaController] : HTTP/JSON
UI --> [EspacoController] : HTTP/JSON

[ReservaController] --> ServiceReserva
[PagamentoController] --> ServicePagamento

ServiceReserva --> ServicePagamento : Solicita cobrança
ServiceReserva --> [ReservaRepository] : Persiste dados
ServiceFilial --> [EspacoRepository]

[ReservaRepository] --> DB : SQL (Transações ACID)
[EspacoRepository] --> DB : SQL

@enduml